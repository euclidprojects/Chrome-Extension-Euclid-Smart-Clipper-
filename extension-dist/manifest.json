{
  "manifest_version": 3,
  "name": "Euclid Smart Clipper",
  "short_name": "Euclid Clipper",
  "version": "1.0.0",
  "description": "Clip, annotate, capture, and save web content to Euclid Smart Notes.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Euclid Smart Clipper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel",
    "scripting",
    "downloads",
    "tabs",
    "offscreen",
    "identity"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://euclidprojects.org https://*.euclidprojects.org https://euclid-projects.firebaseapp.com https://euclid-projects.web.app; connect-src 'self' https://apis.google.com https://www.gstatic.com https://www.googleapis.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com https://euclid-projects.firebaseapp.com https://euclid-projects.web.app https://*.firebaseapp.com https://*.firebaseio.com https://*.euclidprojects.org https://euclidprojects.org;"
  },

  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://music.youtube.com/*",
    "https://*.firebaseapp.com/*",
    "https://*.firebaseio.com/*",
    "https://*.googleapis.com/*",
    "https://*.euclidprojects.org/*",
    "https://euclidprojects.org/*"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Open Euclid Smart Clipper Popup"
    },
    "clip_article": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clip Simplified Article"
    },
    "capture_screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture Screenshot"
    },
    "add_youtube_timestamp": {
      "suggested_key": {
        "default": "Alt+N"
      },
      "description": "Add YouTube Timestamped Note"
    }
  }
}
