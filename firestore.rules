rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection and Subcollections (users/{userId}/notes, users/{userId}/clips, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-Level Notes Collections (/Notes and /notes)
    match /Notes/{noteId} {
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid;

      allow read, delete: if signedIn()
        && resource.data.user_id == request.auth.uid;

      allow update: if signedIn()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.user_id == request.auth.uid;
    }

    match /notes/{noteId} {
      allow create: if signedIn()
        && (request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid);

      allow read, delete: if signedIn()
        && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid);

      allow update: if signedIn()
        && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid)
        && (request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Top-Level Notebooks Collection (/notebooks and /Notebooks)
    match /notebooks/{notebookId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /Notebooks/{notebookId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    // Top-Level Folders Collection (/Folders and /folders)
    match /Folders/{folderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    match /folders/{folderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    // Top-Level Tags Collection (/Tags and /tags)
    match /Tags/{tagId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    match /tags/{tagId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }

    // Top-Level Attachments Collection
    match /Attachments/{attachmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) && (request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid);
    }
  }
}


