rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection and Subcollections
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Top-Level Notes Collections (/Notes and /notes)
    match /Notes/{noteId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid)
      );
    }

    match /notes/{noteId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid) &&
        (request.resource == null || request.resource.data.user_id == request.auth.uid || request.resource.data.userId == request.auth.uid)
      );
    }

    // Notebooks Collection
    match /notebooks/{notebookId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid)
      );
    }

    // Folders Collection
    match /Folders/{folderId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid)
      );
    }

    // Tags Collection
    match /Tags/{tagId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid)
      );
    }

    // Attachments Collection
    match /Attachments/{attachmentId} {
      allow read, create, update, delete: if isSignedIn() && (
        (resource == null || resource.data.userId == request.auth.uid || resource.data.user_id == request.auth.uid) &&
        (request.resource == null || request.resource.data.userId == request.auth.uid || request.resource.data.user_id == request.auth.uid)
      );
    }
  }
}

