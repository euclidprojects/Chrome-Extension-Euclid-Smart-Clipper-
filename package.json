{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "clean": "node scripts/clean-extension.mjs",
    "build:extension": "node generate-pngs.js && BUILD_TARGET=extension vite build && esbuild src/content/contentScript.ts --bundle --outfile=dist/contentScript.js && node scripts/verify-popup-fix.mjs && node scripts/verify-ui-requirements.mjs && node scripts/verify-floating-toolbar-bug-fix.mjs && node scripts/verify-screenshot-editor-fix.mjs && node scripts/verify-extension-build.mjs",
    "build:website": "BUILD_TARGET=website vite build && node scripts/verify-website-build.mjs",
    "build": "npm run clean && npm run build:extension && npm run build:website",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:package": "node scripts/verify-extension-package.mjs",
    "release": "npm run build && npm run package:extension && npm run verify:package",
    "package": "npm run release",
    "test": "node scripts/verify-ui-requirements.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.2.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dompurify": "^3.4.12",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "turndown": "^7.2.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
